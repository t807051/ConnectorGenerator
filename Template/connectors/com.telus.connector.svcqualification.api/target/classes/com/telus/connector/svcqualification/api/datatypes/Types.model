package com.telus.connector.svcqualification.api.datatypes

import com.telus.common.api.datatypes.AbstractDataRecord


struct GetSvcQualificationRequest {
	string lpdsId
}

struct GetSvcQualificationDataRecord : AbstractDataRecord {
	GetSvcQualificationEntity svcQualificationEntity
}

struct GetSvcQualificationEntity  {
	string id    
    string qualificationResult
    string externalId
    string description
    ServiceQualificationItem[] serviceQualificationItem
}

struct ServiceQualificationItem {
    string id // Can be Long or string
    string qualificationResult
    string expectedServiceAvailabilityDate
    ServiceSpecification serviceSpecification
    Service service
}

struct ServiceSpecification {
	string name
}

struct Service {
    Characteristic[] characteristic
    Place[] place
    EligibilityUnavailabilityReason[] eligibilityUnavailabilityReason
}

struct Characteristic {
    string name
    string value // Can be string, Boolean, Number, or null
}

struct Place {
    string role
    string id // Can be Long or String
}

struct EligibilityUnavailabilityReason {
    string label
    int code
}